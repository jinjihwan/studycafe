# Copy to .env (git-ignored). These are examples, not valid credentials.
FIREBASE_PROJECT_ID=replace-with-your-firebase-project-id
# Public Firebase Web SDK configuration from Firebase Console -> Project settings -> Your apps.
# JSON must be on a single line; values are public client identifiers, NOT service account keys.
FIREBASE_WEB_CONFIG='{"apiKey":"replace-with-web-api-key","authDomain":"your-project.firebaseapp.com","projectId":"replace-with-your-firebase-project-id","appId":"1:replace:web:replace"}'
# Path to ADMIN SERVICE ACCOUNT JSON, located OUTSIDE your git project. NEVER expose this file.
GOOGLE_APPLICATION_CREDENTIALS=/home/codespace/.config/snu-studyroom/firebase-admin.json
# Optional: set the EXACT public Codespaces origin, no path and no trailing slash.
# STUDYROOM_PUBLIC_ORIGIN=https://your-codespace-3000.app.github.dev
# Optional: when using a private env secret in production, keep it stable for guests.
# STUDYROOM_SECRET=your-own-random-secret-with-at-least-32-characters

# v5.3 production PostgreSQL: set in Railway Variables using a service reference,
# e.g. ${{Postgres.DATABASE_URL}} (actual database service name may vary).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB
# Mandatory in production. Never commit a real value.
# NODE_ENV=production
# STUDYROOM_SECRET=64-character-random-secret-for-guest-token-signing
# STUDYROOM_PUBLIC_ORIGIN=https://your-service.up.railway.app
# Railway server-only Firebase credentials: JSON as a secret variable,
# not a public web config, do not include in ZIP/Git.
# FIREBASE_SERVICE_ACCOUNT_JSON={...service account JSON...}
